#!/usr/bin/env bash
# ==============================================================================
#  markus — Wrapper for markus-engine (v3.0.0 Pure Rust)
# ==============================================================================

# Ensure ~/.local/bin is in PATH so markus-engine can be found
export PATH="$HOME/.local/bin:$PATH"

if command -v markus-engine >/dev/null 2>&1; then
    # Execute the Rust engine, passing any arguments along
    exec markus-engine "$@"
else
    echo -e "\033[91m\033[1m✘ Error:\033[0m markus-engine not found in PATH."
    echo -e "Please run \033[96m./install-engine.sh\033[0m first to build the Rust engine."
    exit 1
fi
